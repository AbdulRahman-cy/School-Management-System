                                            LAB:      {bg:"#f0fdf4",border:"#bbf7d0",badge:"#d1fae5",badgeTxt:"#065f46",dot:"#10b981"},
                                            TUTORIAL: {bg:"#fffbeb",border:"#fde68a",badge:"#fef3c7",badgeTxt:"#92400e",dot:"#f59e0b"},
