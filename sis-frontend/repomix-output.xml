                                {day.slice(0,3).toUpperCase()}
                                {d===getAlexDay()&&<div style={{ position:"absolute", bottom:0, left:"50%", transform:"translateX(-50%)", width:20, height:2, background:"#7c3aed", borderRadius:99 }} />}
                              </th>
                            ))}
                          </tr>
                        </thead>
                        <tbody>
