          </div>
        </div>

        {/* Upcoming Events (Timeline) */}
        <div style={{
          background: "#fff", borderRadius: 16, padding: "18px 20px", border: "1px solid #ede9fe",
          boxShadow: "0 10px 30px rgba(124,58,237,0.04)", display: "flex", flexDirection: "column", gap: 12, flex: 1
