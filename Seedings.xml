        self.stdout.write(f"  ├─ Teachers:       {TeacherProfile.objects.count()}")
        self.stdout.write(f"  └─ Admins/Staff:   {BaseUser.objects.filter(is_staff=True).count()}")

        # 2. Academic Infrastructure
