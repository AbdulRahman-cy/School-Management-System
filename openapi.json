components:
  schemas:
    AddStudyGroupRequest:
      type: object
      properties:
        discipline_id:
          type: integer
        term_id:
          type: integer
        year_level:
          type: integer
          maximum: 4
          minimum: 1
        number:
          type: integer
          minimum: 1
        capacity:
          type: integer
          minimum: 1
          default: 50
      required:
      - discipline_id
      - number
      - term_id
      - year_level
    AddStudyGroupResponse:
      type: object
      properties:
        message:
          type: string
        id:
          type: integer
      required:
      - id
      - message
    Assignment:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        course_class:
          type: integer
        course_code:
          type: string
          readOnly: true
        course_title:
          type: string
          readOnly: true
        assignment_type:
          $ref: '#/components/schemas/AssignmentTypeEnum'
        due_week:
          type: integer
          maximum: 32767
          minimum: 0
          description: Week number within the term by which the assignment is due
            (1-based).
        max_points:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - assignment_type
      - course_class
      - course_code
      - course_title
      - created_at
      - due_week
      - id
      - max_points
      - updated_at
    AssignmentTypeEnum:
      enum:
      - HOMEWORK
      - PROJECT
      - ESSAY
      type: string
      description: |-
        * `HOMEWORK` - Homework
        * `PROJECT` - Project
        * `ESSAY` - Essay
    AttendanceRecord:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        student:
          type: integer
        session:
          type: integer
        term_name:
          type: string
          readOnly: true
        course_code:
          type: string
          readOnly: true
        course_title:
          type: string
          readOnly: true
        session_type:
          type: string
          readOnly: true
        week:
          type: integer
          maximum: 32767
          minimum: 0
          description: Week number within the term (1-based).
        status:
          $ref: '#/components/schemas/AttendanceRecordStatusEnum'
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - course_code
      - course_title
      - created_at
      - id
      - session
      - session_type
      - status
      - student
      - term_name
      - updated_at
      - week
    AttendanceRecordStatusEnum:
      enum:
      - PRESENT
      - ABSENT
      - LATE
      - EXCUSED
      type: string
      description: |-
        * `PRESENT` - Present
        * `ABSENT` - Absent
        * `LATE` - Late
        * `EXCUSED` - Excused
    BaseUser:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        email:
          type: string
          format: email
          maxLength: 254
        first_name:
          type: string
          maxLength: 150
        last_name:
          type: string
          maxLength: 150
        role:
          $ref: '#/components/schemas/RoleEnum'
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - email
      - first_name
      - id
      - last_name
      - role
      - updated_at
    BulkCreateCohortResponse:
      type: object
      properties:
        message:
          type: string
        groups_created:
          type: integer
        classes_created:
          type: integer
        group_ids:
          type: array
          items:
            type: integer
        class_ids:
          type: array
          items:
            type: integer
      required:
      - class_ids
      - classes_created
      - group_ids
      - groups_created
      - message
    CohortBulkCreate:
      type: object
      properties:
        discipline_id:
          type: integer
        term_id:
          type: integer
        year_level:
          type: integer
          maximum: 4
          minimum: 1
        groups:
          type: array
          items:
            $ref: '#/components/schemas/StudyGroupInput'
        courses:
          type: array
          items:
            type: integer
        coordinators:
          type: object
          additionalProperties:
            type: integer
            nullable: true
      required:
      - courses
      - discipline_id
      - groups
      - term_id
      - year_level
    CohortCourseClassRead:
      type: object
      description: Serializes a CourseClass enriched with its group number and coordinator
        name.
      properties:
        id:
          type: integer
        course:
          $ref: '#/components/schemas/_CourseInline'
        group_number:
          type: integer
        coordinator:
          allOf:
          - $ref: '#/components/schemas/_CoordinatorInline'
          nullable: true
      required:
      - coordinator
      - course
      - group_number
      - id
    CohortGroupRead:
      type: object
      description: Serializes a single StudyGroup as a lightweight group descriptor.
      properties:
        id:
          type: integer
        number:
          type: integer
        capacity:
          type: integer
      required:
      - capacity
      - id
      - number
    CohortRead:
      type: object
      description: |-
        Virtual serializer for a Cohort — a logical grouping of StudyGroups sharing
        the same (discipline, term, year_level) triple.

        Instances are plain dicts built by CohortViewSet.cohorts() rather than
        ORM model instances.
      properties:
        id:
          type: string
          readOnly: true
        discipline:
          $ref: '#/components/schemas/Discipline'
        term:
          $ref: '#/components/schemas/Term'
        year_level:
          type: integer
        groups:
          type: array
          items:
            $ref: '#/components/schemas/CohortGroupRead'
        course_classes:
          type: array
          items:
            $ref: '#/components/schemas/CohortCourseClassRead'
        schedule_status:
          $ref: '#/components/schemas/ScheduleStatusEnum'
      required:
      - course_classes
      - discipline
      - groups
      - id
      - schedule_status
      - term
      - year_level
    Course:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        code:
          type: string
          maxLength: 20
        title:
          type: string
          maxLength: 200
        credits:
          type: integer
          maximum: 32767
          minimum: 0
        course_type:
          $ref: '#/components/schemas/CourseTypeEnum'
        department:
          allOf:
          - $ref: '#/components/schemas/Department'
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - code
      - created_at
      - credits
      - department
      - id
      - title
      - updated_at
    CourseClass:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        course:
          allOf:
          - $ref: '#/components/schemas/Course'
          readOnly: true
        course_id:
          type: integer
          writeOnly: true
        group:
          allOf:
          - $ref: '#/components/schemas/StudyGroup'
          readOnly: true
        group_id:
          type: integer
          writeOnly: true
        coordinator_id:
          type: integer
          nullable: true
        schedule_dirty:
          type: boolean
          readOnly: true
          description: 'True when a solver-relevant input (currently: coordinator)
            changed after this class was already scheduled, so its existing sessions
            no longer reflect the intended constraints. Cleared once the cohort is
            (re)scheduled.'
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - course
      - created_at
      - group
      - id
      - schedule_dirty
      - updated_at
    CourseTypeEnum:
      enum:
      - CORE
      - ELECTIVE
      type: string
      description: |-
        * `CORE` - Core
        * `ELECTIVE` - Elective
    CustomTokenObtainPair:
      type: object
      properties:
        email:
          type: string
          writeOnly: true
        password:
          type: string
          writeOnly: true
      required:
      - email
      - password
    DayEnum:
      enum:
      - 0
      - 1
      - 2
      - 3
      - 4
      - 5
      type: integer
      description: |-
        * `0` - Saturday
        * `1` - Sunday
        * `2` - Monday
        * `3` - Tuesday
        * `4` - Wednesday
        * `5` - Thursday
    Department:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 200
        code:
          type: string
          maxLength: 10
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - code
      - created_at
      - id
      - name
