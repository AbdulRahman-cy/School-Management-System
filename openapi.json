openapi: 3.0.3
info:
  title: University SIS API
  version: 1.0.0
  description: Academic records, scheduling, and enrollment endpoints.
paths:
  /api/academics/admin-dashboard/:
    get:
      operationId: academics_admin_dashboard_retrieve
      description: |-
        Global metrics for the active term, used by the Admin Dashboard landing
        view. Everything here is DB-aggregated — no per-row queries — to avoid
        N+1s against CourseClass/Session/Enrollment.
      tags:
      - academics
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /api/academics/classes/:
    get:
      operationId: academics_classes_list
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - academics
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedCourseClassList'
          description: ''
    post:
      operationId: academics_classes_create
      tags:
      - academics
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CourseClass'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CourseClass'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CourseClass'
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CourseClass'
          description: ''
  /api/academics/classes/{id}/:
    get:
      operationId: academics_classes_retrieve
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this course class.
        required: true
      tags:
      - academics
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CourseClass'
          description: ''
    put:
      operationId: academics_classes_update
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this course class.
        required: true
      tags:
      - academics
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CourseClass'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CourseClass'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CourseClass'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CourseClass'
          description: ''
    patch:
      operationId: academics_classes_partial_update
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this course class.
        required: true
      tags:
      - academics
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedCourseClass'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedCourseClass'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedCourseClass'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CourseClass'
          description: ''
    delete:
      operationId: academics_classes_destroy
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this course class.
        required: true
      tags:
      - academics
      security:
      - cookieAuth: []
      responses:
        '204':
          description: No response body
  /api/academics/cohorts/add-group/:
    post:
      operationId: academics_cohorts_add_group_create
      description: |-
        Handles all cohort-level operations (listing, creation, scheduling,
        adding study groups, and deletion). Cohorts are virtual entities
        represented by (discipline, term, year_level) triples.
      summary: Add a study group to an existing cohort
      tags:
      - academics
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AddStudyGroupRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AddStudyGroupRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AddStudyGroupRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AddStudyGroupResponse'
          description: ''
        '409':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/academics/cohorts/bulk-cohort/:
    post:
      operationId: academics_cohorts_bulk_cohort_create
      description: Atomically creates all StudyGroup and CourseClass instances for
        a new cohort.
      summary: Bulk create a cohort
      tags:
      - academics
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CohortBulkCreate'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CohortBulkCreate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CohortBulkCreate'
        required: true
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BulkCreateCohortResponse'
          description: ''
  /api/academics/cohorts/cohorts/:
    get:
      operationId: academics_cohorts_cohorts_list
      description: Retrieves a list of cohorts grouped by discipline, term, and year
        level.
      summary: List all cohorts
      parameters:
      - in: query
        name: discipline
        schema:
          type: integer
        description: Alias for discipline_id
      - in: query
        name: discipline_id
        schema:
          type: integer
        description: Filter by discipline ID
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: term_status
        schema:
          type: string
          default: active
        description: Filter by term status (active, past, all)
      tags:
      - academics
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedCohortReadList'
          description: ''
    delete:
      operationId: academics_cohorts_cohorts_destroy
      description: Deletes all study groups and associated course classes for the
        specified cohort.
      summary: Delete a cohort
      parameters:
      - in: query
        name: discipline_id
        schema:
          type: integer
        required: true
      - in: query
        name: term_id
        schema:
          type: integer
        required: true
      - in: query
        name: year_level
        schema:
          type: integer
          maximum: 4
          minimum: 1
        required: true
      tags:
      - academics
      security:
      - cookieAuth: []
      responses:
        '204':
          description: No response body
        '404':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/academics/cohorts/schedule-cohort/:
    post:
      operationId: academics_cohorts_schedule_cohort_create
      description: Runs the CP-SAT solver to generate a conflict-free timetable for
        the cohort.
      summary: Schedule a cohort
      tags:
      - academics
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ScheduleCohortRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ScheduleCohortRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ScheduleCohortRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ScheduleCohortResponse'
          description: ''
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ScheduleCohortResponse'
          description: ''
        '409':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RescheduleConfirmationResponse'
          description: ''
        '400':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
