# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Read by both the `db` container (to initialise the database) and Django.
POSTGRES_DB=university_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=change-me

# Defaults to the `db` Compose service. Point these at RDS in production.
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# ─── Django ───────────────────────────────────────────────────────────────────
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# `production` sets DEBUG=False; any other value enables DEBUG.
ENVIRONMENT=development

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# ─── Optional ─────────────────────────────────────────────────────────────────
# Only needed when the frontend is served from a different origin than the API.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Enable only once TLS is terminated in front of Nginx.
# SECURE_SSL_REDIRECT=False
